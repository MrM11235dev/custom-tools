#!/bin/bash
#
# workspace-create — build a VS Code .code-workspace file from a list of
# project directories.
#
#   workspace-create -f backend ~/code/api ~/code/worker ~/code/shared
#
# Written for macOS' stock bash 3.2 — no arrays-of-arrays, no `realpath`,
# no `jq`, no other dependencies.

set -euo pipefail

PROGRAM_NAME="workspace-create"
VERSION="1.0.0"

usage() {
	cat <<EOF
$PROGRAM_NAME $VERSION — create a VS Code .code-workspace file

Usage:
  $PROGRAM_NAME [-f FILENAME] [options] DIR [DIR ...]

Options:
  -f, --file FILENAME  Workspace file to write. The .code-workspace extension
                       is appended when missing, and FILENAME may include a
                       directory part. (default: name of the current directory)
  -a, --absolute       Write absolute folder paths instead of paths relative
                       to the workspace file.
  -F, --force          Overwrite FILENAME when it already exists.
  -o, --open           Open the workspace in VS Code after writing it.
  -q, --quiet          Print errors only.
  -h, --help           Show this help.
  -V, --version        Show the version.

Examples:
  $PROGRAM_NAME -f backend ~/code/api ~/code/worker
  $PROGRAM_NAME -f ~/Desktop/everything -a ~/code/*/
  $PROGRAM_NAME -f client --open ../web ../mobile
EOF
}

die() {
	printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
	exit 1
}

log() {
	[ "$quiet" -eq 1 ] || printf '%s\n' "$*"
}

# Escape a string for use inside a JSON double-quoted value.
json_escape() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\t'/\\t}
	s=${s//$'\n'/\\n}
	s=${s//$'\r'/\\r}
	printf '%s' "$s"
}

# relpath TARGET BASE — path of TARGET as seen from directory BASE.
# Both arguments must be absolute, normalised paths.
relpath() {
	local target=$1 base=$2
	if [ "$target" = "$base" ]; then
		printf '.'
		return
	fi

	local common=$base up="" rest
	while [ "$common" != "/" ]; do
		case "$target" in
			"$common"/*) break ;;
		esac
		common=$(dirname "$common")
		up="../$up"
	done

	rest=${target#"$common"}
	rest=${rest#/}
	if [ -z "$rest" ]; then
		printf '%s' "${up%/}"
	else
		printf '%s' "$up$rest"
	fi
}

output_file=""
use_absolute=0
force=0
open_after=0
quiet=0
inputs=()

while [ $# -gt 0 ]; do
	case "$1" in
		-f|--file)
			[ $# -ge 2 ] || die "option $1 requires a filename"
			output_file=$2
			shift 2
			;;
		--file=*)
			output_file=${1#--file=}
			shift
			;;
		-a|--absolute) use_absolute=1; shift ;;
		-F|--force)    force=1;        shift ;;
		-o|--open)     open_after=1;   shift ;;
		-q|--quiet)    quiet=1;        shift ;;
		-h|--help)     usage; exit 0 ;;
		-V|--version)  printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"; exit 0 ;;
		--)
			shift
			while [ $# -gt 0 ]; do
				inputs[${#inputs[@]}]=$1
				shift
			done
			;;
		-*)
			die "unknown option: $1 (try --help)"
			;;
		*)
			inputs[${#inputs[@]}]=$1
			shift
			;;
	esac
done

if [ ${#inputs[@]} -eq 0 ]; then
	usage >&2
	exit 2
fi

# Default the workspace name to the current directory's name.
if [ -z "$output_file" ]; then
	output_file=$(basename "$(pwd -P)")
fi
case "$output_file" in
	*.code-workspace) ;;
	*) output_file="$output_file.code-workspace" ;;
esac

out_dir_raw=$(dirname "$output_file")
out_dir=$(cd "$out_dir_raw" 2>/dev/null && pwd -P) ||
	die "output directory does not exist: $out_dir_raw"
out_path="$out_dir/$(basename "$output_file")"

if [ -e "$out_path" ] && [ "$force" -eq 0 ]; then
	die "$out_path already exists (use --force to overwrite)"
fi

# Resolve every input to an absolute path, dropping duplicates.
paths=()
for raw in "${inputs[@]}"; do
	[ -e "$raw" ] || die "no such file or directory: $raw"
	[ -d "$raw" ] || die "not a directory: $raw"
	abs=$(cd "$raw" 2>/dev/null && pwd -P) || die "cannot enter directory: $raw"

	duplicate=0
	for seen in ${paths[@]+"${paths[@]}"}; do
		if [ "$seen" = "$abs" ]; then
			duplicate=1
			break
		fi
	done
	if [ "$duplicate" -eq 1 ]; then
		log "skipping duplicate: $abs"
		continue
	fi

	paths[${#paths[@]}]=$abs
done

# Label each folder with its directory name, qualified by the parent directory
# when two inputs share the same name.
names=()
i=0
while [ $i -lt ${#paths[@]} ]; do
	base=$(basename "${paths[$i]}")
	collides=0
	j=0
	while [ $j -lt ${#paths[@]} ]; do
		if [ $j -ne $i ] && [ "$(basename "${paths[$j]}")" = "$base" ]; then
			collides=1
			break
		fi
		j=$((j + 1))
	done
	if [ "$collides" -eq 1 ]; then
		names[$i]="$(basename "$(dirname "${paths[$i]}")")/$base"
	else
		names[$i]=$base
	fi
	i=$((i + 1))
done

tmp=$(mktemp "${TMPDIR:-/tmp}/$PROGRAM_NAME.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	printf '{\n'
	printf '\t"folders": [\n'
	i=0
	while [ $i -lt ${#paths[@]} ]; do
		if [ "$use_absolute" -eq 1 ]; then
			folder_path=${paths[$i]}
		else
			folder_path=$(relpath "${paths[$i]}" "$out_dir")
		fi
		printf '\t\t{\n'
		printf '\t\t\t"name": "%s",\n' "$(json_escape "${names[$i]}")"
		printf '\t\t\t"path": "%s"\n' "$(json_escape "$folder_path")"
		if [ $i -lt $((${#paths[@]} - 1)) ]; then
			printf '\t\t},\n'
		else
			printf '\t\t}\n'
		fi
		i=$((i + 1))
	done
	printf '\t],\n'
	printf '\t"settings": {}\n'
	printf '}\n'
} >"$tmp"

mv "$tmp" "$out_path"
trap - EXIT

log "Created $out_path with ${#paths[@]} folder(s):"
i=0
while [ $i -lt ${#paths[@]} ] && [ "$quiet" -eq 0 ]; do
	printf '  %s -> %s\n' "${names[$i]}" "${paths[$i]}"
	i=$((i + 1))
done

if [ "$open_after" -eq 1 ]; then
	if command -v code >/dev/null 2>&1; then
		code "$out_path"
	else
		open -a "Visual Studio Code" "$out_path"
	fi
fi
